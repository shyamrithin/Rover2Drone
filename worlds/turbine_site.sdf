<?xml version="1.0" ?>
<!--
  turbine_site.sdf
  Demonstration world for the Rover2Drone marsupial inspection stack.

  Contains a parked wind turbine (generated tower and blade meshes, see
  tools/gen_turbine_meshes.py) and a four-wheel skid-steer ground rover.
  The aerial vehicle is NOT defined here: PX4 SITL attaches to this world
  in standalone mode and spawns the x500 itself.

  Scale: hub height 12.5 m, blade length 6 m. Roughly half a small
  commercial machine, far under utility scale (80-120 m hub, 40-60 m
  blades). Chosen for demonstration legibility. Replace with correctly
  scaled geometry before claiming any quantitative result.

  Blade visuals are smooth lofted airfoil meshes (~9.8k triangles each);
  blade collision is a single coarse box per blade, deliberately cheap.
  The turbine is static, so no inertia is specified for it.

  Rover suspension arms are visual only. True rocker-bogie articulation
  is deferred: it needs six wheels and a rocker differential.

  Topics published:  /rover/odometry  (gz.msgs.Odometry)
  Topics subscribed: /rover/cmd_vel   (gz.msgs.Twist)
-->
<sdf version="1.9">
  <world name="turbine_site">

    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.65 0.65 0.68 1</ambient>
      <background>0.72 0.82 0.92 1</background>
      <sky/>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 60 0 0 0</pose>
      <diffuse>0.92 0.92 0.90 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.35 -0.78</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <material>
            <ambient>0.34 0.40 0.26 1</ambient>
            <diffuse>0.44 0.52 0.33 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wind_turbine">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <link name="tower">
        <visual name="visual">
          <geometry>
            <mesh><uri>model://turbine/meshes/tower.obj</uri></mesh>
          </geometry>
          <material>
            <ambient>0.80 0.80 0.82 1</ambient>
            <diffuse>0.94 0.94 0.95 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <pose>0 0 6.25 0 0 0</pose>
          <geometry><cylinder><radius>0.7</radius><length>12.5</length></cylinder></geometry>
        </collision>
      </link>

      <link name="nacelle">
        <pose>0 0 12.95 0 0 0</pose>
        <visual name="body">
          <pose>-0.35 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.58</radius><length>2.6</length></cylinder></geometry>
          <material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.93 0.93 0.95 1</diffuse></material>
        </visual>
        <visual name="rear_cap">
          <pose>-1.65 0 0 0 0 0</pose>
          <geometry><sphere><radius>0.58</radius></sphere></geometry>
          <material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.93 0.93 0.95 1</diffuse></material>
        </visual>
        <visual name="fin">
          <pose>-1.5 0 0.62 0 0 0</pose>
          <geometry><box><size>0.85 0.08 0.62</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.68 0.68 0.71 1</diffuse></material>
        </visual>
        <collision name="collision">
          <pose>-0.35 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.58</radius><length>2.6</length></cylinder></geometry>
        </collision>
      </link>

      <link name="hub">
        <pose>1.15 0 12.95 0 0 0</pose>
        <visual name="spinner">
          <pose>0.1 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.45</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.85 0.85 0.86 1</ambient><diffuse>0.95 0.95 0.96 1</diffuse></material>
        </visual>
        <visual name="nose">
          <pose>0.45 0 0 0 0 0</pose>
          <geometry><sphere><radius>0.45</radius></sphere></geometry>
          <material><ambient>0.85 0.85 0.86 1</ambient><diffuse>0.95 0.95 0.96 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.48</radius></sphere></geometry>
        </collision>
      </link>

      <link name="blade_1">
        <pose>1.15 0 12.95 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <mesh><uri>model://turbine/meshes/blade.obj</uri></mesh>
          </geometry>
          <material>
            <ambient>0.84 0.84 0.85 1</ambient>
            <diffuse>0.96 0.96 0.97 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <pose>0 0 3.2 0 0 0</pose>
          <geometry><box><size>0.3 0.62 6.0</size></box></geometry>
        </collision>
      </link>

      <link name="blade_2">
        <pose>1.15 0 12.95 2.0944 0 0</pose>
        <visual name="visual">
          <geometry>
            <mesh><uri>model://turbine/meshes/blade.obj</uri></mesh>
          </geometry>
          <material>
            <ambient>0.84 0.84 0.85 1</ambient>
            <diffuse>0.96 0.96 0.97 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <pose>0 0 3.2 0 0 0</pose>
          <geometry><box><size>0.3 0.62 6.0</size></box></geometry>
        </collision>
      </link>

      <link name="blade_3">
        <pose>1.15 0 12.95 4.18879 0 0</pose>
        <visual name="visual">
          <geometry>
            <mesh><uri>model://turbine/meshes/blade.obj</uri></mesh>
          </geometry>
          <material>
            <ambient>0.84 0.84 0.85 1</ambient>
            <diffuse>0.96 0.96 0.97 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <pose>0 0 3.2 0 0 0</pose>
          <geometry><box><size>0.3 0.62 6.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="rover">
      <pose>8 0 0.22 0 0 3.14159</pose>

      <link name="base_link">
        <inertial>
          <mass>22.0</mass>
          <inertia>
            <ixx>0.95</ixx><iyy>1.80</iyy><izz>2.30</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="chassis">
          <geometry><box><size>0.92 0.52 0.16</size></box></geometry>
          <material><ambient>0.62 0.22 0.08 1</ambient><diffuse>0.82 0.33 0.12 1</diffuse></material>
        </visual>
        <visual name="upper_body">
          <pose>0.05 0 0.13 0 0 0</pose>
          <geometry><box><size>0.62 0.46 0.12</size></box></geometry>
          <material><ambient>0.58 0.20 0.07 1</ambient><diffuse>0.78 0.30 0.11 1</diffuse></material>
        </visual>
        <visual name="deck">
          <pose>0.05 0 0.21 0 0 0</pose>
          <geometry><box><size>0.5 0.5 0.03</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.20 0.20 0.22 1</diffuse></material>
        </visual>
        <visual name="deck_marker">
          <pose>0.05 0 0.229 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.004</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.98 0.98 0.98 1</diffuse></material>
        </visual>
        <visual name="mast">
          <pose>-0.36 0 0.24 0 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.22 0.22 0.22 1</diffuse></material>
        </visual>
        <visual name="arm_fl">
          <pose>0.17 0.24 -0.05 0.6 0 0</pose>
          <geometry><box><size>0.09 0.05 0.20</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
        </visual>
        <visual name="arm_fr">
          <pose>0.17 -0.24 -0.05 -0.6 0 0</pose>
          <geometry><box><size>0.09 0.05 0.20</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
        </visual>
        <visual name="arm_rl">
          <pose>-0.17 0.24 -0.05 0.6 0 0</pose>
          <geometry><box><size>0.09 0.05 0.20</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
        </visual>
        <visual name="arm_rr">
          <pose>-0.17 -0.24 -0.05 -0.6 0 0</pose>
          <geometry><box><size>0.09 0.05 0.20</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.92 0.52 0.16</size></box></geometry>
        </collision>
      </link>

      <link name="wheel_fl">
        <pose>0.28 0.33 -0.03 -1.5707 0 0</pose>
        <inertial>
          <mass>1.1</mass>
          <inertia><ixx>0.007</ixx><iyy>0.007</iyy><izz>0.012</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="tyre">
          <geometry><cylinder><radius>0.19</radius><length>0.11</length></cylinder></geometry>
          <material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.14 0.14 0.14 1</diffuse></material>
        </visual>
        <visual name="hubcap">
          <pose>0 0 0.056 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.012</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.19</radius><length>0.11</length></cylinder></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>0.35</mu2></ode></friction></surface>
        </collision>
      </link>

      <link name="wheel_fr">
        <pose>0.28 -0.33 -0.03 -1.5707 0 0</pose>
        <inertial>
          <mass>1.1</mass>
          <inertia><ixx>0.007</ixx><iyy>0.007</iyy><izz>0.012</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="tyre">
          <geometry><cylinder><radius>0.19</radius><length>0.11</length></cylinder></geometry>
          <material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.14 0.14 0.14 1</diffuse></material>
        </visual>
        <visual name="hubcap">
          <pose>0 0 -0.056 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.012</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.19</radius><length>0.11</length></cylinder></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>0.35</mu2></ode></friction></surface>
        </collision>
      </link>

      <link name="wheel_rl">
        <pose>-0.28 0.33 -0.03 -1.5707 0 0</pose>
        <inertial>
          <mass>1.1</mass>
          <inertia><ixx>0.007</ixx><iyy>0.007</iyy><izz>0.012</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="tyre">
          <geometry><cylinder><radius>0.19</radius><length>0.11</length></cylinder></geometry>
          <material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.14 0.14 0.14 1</diffuse></material>
        </visual>
        <visual name="hubcap">
          <pose>0 0 0.056 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.012</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.19</radius><length>0.11</length></cylinder></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>0.35</mu2></ode></friction></surface>
        </collision>
      </link>

      <link name="wheel_rr">
        <pose>-0.28 -0.33 -0.03 -1.5707 0 0</pose>
        <inertial>
          <mass>1.1</mass>
          <inertia><ixx>0.007</ixx><iyy>0.007</iyy><izz>0.012</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="tyre">
          <geometry><cylinder><radius>0.19</radius><length>0.11</length></cylinder></geometry>
          <material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.14 0.14 0.14 1</diffuse></material>
        </visual>
        <visual name="hubcap">
          <pose>0 0 -0.056 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.012</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.19</radius><length>0.11</length></cylinder></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>0.35</mu2></ode></friction></surface>
        </collision>
      </link>

      <joint name="wheel_fl_joint" type="revolute">
        <parent>base_link</parent><child>wheel_fl</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz>
              <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="wheel_fr_joint" type="revolute">
        <parent>base_link</parent><child>wheel_fr</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz>
              <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="wheel_rl_joint" type="revolute">
        <parent>base_link</parent><child>wheel_rl</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz>
              <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="wheel_rr_joint" type="revolute">
        <parent>base_link</parent><child>wheel_rr</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz>
              <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>wheel_fl_joint</left_joint>
        <left_joint>wheel_rl_joint</left_joint>
        <right_joint>wheel_fr_joint</right_joint>
        <right_joint>wheel_rr_joint</right_joint>
        <wheel_separation>0.66</wheel_separation>
        <wheel_radius>0.19</wheel_radius>
        <max_linear_acceleration>1.5</max_linear_acceleration>
        <topic>/rover/cmd_vel</topic>
        <odom_topic>/rover/odometry</odom_topic>
        <tf_topic>/rover/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>rover/base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>

  </world>
</sdf>
