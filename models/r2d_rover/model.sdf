        <visual name="spoke_0"><pose>0.02475 0.00000 -0.02600 0.00000 0.00000 0.00000</pose><geometry><box><size>0.03600 0.01200 0.00600</size></box></geometry><material><ambient>0.40 0.41 0.42 1</ambient><diffuse>0.60 0.61 0.62 1</diffuse><specular>0.30 0.30 0.30 1</specular></material></visual>
        <visual name="spoke_1"><pose>0.00765 0.02354 -0.02600 0.00000 0.00000 1.25664</pose><geometry><box><size>0.03600 0.01200 0.00600</size></box></geometry><material><ambient>0.40 0.41 0.42 1</ambient><diffuse>0.60 0.61 0.62 1</diffuse><specular>0.30 0.30 0.30 1</specular></material></visual>
        <visual name="spoke_2"><pose>-0.02002 0.01455 -0.02600 0.00000 0.00000 2.51327</pose><geometry><box><size>0.03600 0.01200 0.00600</size></box></geometry><material><ambient>0.40 0.41 0.42 1</ambient><diffuse>0.60 0.61 0.62 1</diffuse><specular>0.30 0.30 0.30 1</specular></material></visual>
        <visual name="spoke_3"><pose>-0.02002 -0.01455 -0.02600 0.00000 0.00000 3.76991</pose><geometry><box><size>0.03600 0.01200 0.00600</size></box></geometry><material><ambient>0.40 0.41 0.42 1</ambient><diffuse>0.60 0.61 0.62 1</diffuse><specular>0.30 0.30 0.30 1</specular></material></visual>
        <visual name="spoke_4"><pose>0.00765 -0.02354 -0.02600 0.00000 0.00000 5.02655</pose><geometry><box><size>0.03600 0.01200 0.00600</size></box></geometry><material><ambient>0.40 0.41 0.42 1</ambient><diffuse>0.60 0.61 0.62 1</diffuse><specular>0.30 0.30 0.30 1</specular></material></visual>
        <visual name="hub_cap"><pose>0.00000 0.00000 -0.02900 0.00000 0.00000 0.00000</pose><geometry><cylinder><radius>0.01400</radius><length>0.01200</length></cylinder></geometry><material><ambient>0.55 0.56 0.58 1</ambient><diffuse>0.80 0.81 0.83 1</diffuse><specular>0.70 0.70 0.70 1</specular></material></visual>
        <collision name="collision"><pose>0.00000 0.00000 0.00000 0.00000 0.00000 0.00000</pose><geometry><sphere><radius>0.075</radius></sphere></geometry><surface><friction><ode><mu>1.1</mu><mu2>0.6</mu2></ode></friction></surface></collision>
      </link>
      <joint name="wheel_fl_joint" type="revolute">
        <parent>base_link</parent><child>wheel_fl</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="wheel_fr_joint" type="revolute">
        <parent>base_link</parent><child>wheel_fr</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="wheel_rl_joint" type="revolute">
        <parent>base_link</parent><child>wheel_rl</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="wheel_rr_joint" type="revolute">
        <parent>base_link</parent><child>wheel_rr</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>wheel_fl_joint</left_joint>
        <left_joint>wheel_rl_joint</left_joint>
        <right_joint>wheel_fr_joint</right_joint>
        <right_joint>wheel_rr_joint</right_joint>
        <wheel_separation>0.600</wheel_separation>
        <wheel_radius>0.075</wheel_radius>
        <max_linear_acceleration>0.5</max_linear_acceleration>
        <max_linear_velocity>0.60</max_linear_velocity>
        <max_angular_velocity>1.0</max_angular_velocity>
        <topic>/rover/cmd_vel</topic>
        <odom_topic>/rover/odometry</odom_topic>
        <tf_topic>/rover/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>rover/base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher"/>
      <!-- Ground truth: exact 3D world pose (x, y, z, roll, pitch, yaw) of
           base_link, for the route follower, evaluation and RViz. The
           DiffDrive odometry above stays as the (2D, drifting) wheel
           odometry for the localisation stack. -->
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>rover/base_link</robot_base_frame>
        <odom_topic>/rover/ground_truth</odom_topic>
        <tf_topic>/rover/ground_truth/tf</tf_topic>
        <dimensions>3</dimensions>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
      <!-- Drone latch. Attaches automatically when x500_gimbal_0 appears
           (retrying silently until PX4 spawns it); latch_manager then
           re-seats it flat on the pad. -->
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>base_link</parent_link>
        <child_model>x500_gimbal_0</child_model>
        <child_link>base_link</child_link>
        <detach_topic>/rover/latch/detach</detach_topic>
        <attach_topic>/rover/latch/attach</attach_topic>
        <output_topic>/rover/latch/state</output_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
  </model>
</sdf>
