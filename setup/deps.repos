# External dependencies pulled by vcstool into src/.
#
# ros_gz is NOT listed here. On machines where ros-humble-ros-gzharmonic is
# available from the Gazebo apt repo, install that binary instead of
# building from source. On machines without it, add back:
#   ros_gz: {type: git, url: https://github.com/gazebosim/ros_gz.git, version: humble}
# and export GZ_VERSION=harmonic before rosdep and colcon.
repositories:
  px4_msgs:
    type: git
    url: https://github.com/PX4/px4_msgs.git
    version: release/1.17
